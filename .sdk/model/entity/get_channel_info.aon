      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "image"
      req: false
      short: "URL to the channel profile image"
      type: "`$STRING`"
    }
    {
      name: "subscribers"
      req: false
      short: "Number of channel subscribers"
      type: "`$INTEGER`"
    }
    {
      name: "title"
      req: false
      short: "Channel title"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "url"
      req: false
      short: "Full URL to the channel"
      type: "`$STRING`"
    }
    {
      name: "username"
      req: false
      short: "Channel username"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "get_channel_info"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "n9he1"
                kind: "param"
                name: "id"
                orig: "channel_username"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /{channelUsername}"
            json: "{\"operationId\":\"getChannelInfo\",\"parameters\":[{\"description\":\"The username of the Telegram channel (without @)\",\"in\":\"path\",\"name\":\"channelUsername\",\"required\":true,\"schema\":{\"example\":\"n9he1\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"description\":{\"description\":\"Channel description\",\"example\":\"مُجرد زاوية أخرى من عالمي, أدون فيها ما لا يصلح للضجيج 🤍\",\"type\":\"string\"},\"image\":{\"description\":\"URL to the channel profile image\",\"format\":\"uri\",\"type\":\"string\"},\"subscribers\":{\"description\":\"Number of channel subscribers\",\"example\":12177,\"type\":\"integer\"},\"title\":{\"description\":\"Channel title\",\"example\":\"» مُـنذ 25 يَنـايِر \\\"🪐♥„\",\"type\":\"string\"},\"url\":{\"description\":\"Full URL to the channel\",\"example\":\"https://t.me/n9he1\",\"format\":\"uri\",\"type\":\"string\"},\"username\":{\"description\":\"Channel username\",\"example\":\"n9he1\",\"type\":\"string\"}},\"type\":\"object\"}},\"text/html\":{\"schema\":{\"description\":\"HTML page containing channel information\",\"type\":\"string\"}}},\"description\":\"Successful response with channel information\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"example\":\"Invalid channel username\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Invalid channel username\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"example\":\"Channel not found\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Channel not found\"},\"429\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"example\":\"Rate limit exceeded\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Too many requests\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/{channelUsername}"
          rename: {
            param: {
              channelUsername: "id"
            }
          }
          segments: [
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



